// GENERATED FILE — do not edit. Generated by CMakeLists.txt (configure_file)
// from cmake/appversion.h.in at configure time.
//
// The version lives in exactly ONE place: project(OpenEkklesia VERSION x.y.z)
// in CMakeLists.txt. Bump it with scripts/set-version.sh.
//
// OE_BUILD_ID carries the git identification of the exact build
// (git describe --tags --always [--dirty]), e.g. "v0.8.5-rc1-3-gd64b2a8".
// Empty when git is unavailable. Regenerated on CMake re-configure, so the
// id may lag within a long editing session between reconfigures.
#ifndef OE_APPVERSION_H
#define OE_APPVERSION_H

#define OE_VERSION_STRING "@OE_VERSION_STRING@"
#define OE_BUILD_ID "@OE_BUILD_ID@"

#endif // OE_APPVERSION_H
