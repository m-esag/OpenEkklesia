CompileFlags:
  CompilationDatabase: build
  Add:
    - -std=gnu++20
    - -isystem
    - /usr/include/c++/15.2.1
    - -isystem
    - /usr/include/c++/15.2.1/x86_64-openmandriva-linux-gnu
    - -isystem
    - /usr/include/c++/15.2.1/backward
    - -isystem
    - /usr/lib64/gcc/x86_64-openmandriva-linux-gnu/15.2.1/include
    - -isystem
    - /usr/include
    - -isystem
    - /usr/lib64/qt6/include
    - -isystem
    - /usr/lib64/qt6/include/QtCore
    - -isystem
    - /usr/lib64/qt6/include/QtGui
    - -isystem
    - /usr/lib64/qt6/include/QtWidgets
    - -isystem
    - /usr/lib64/qt6/include/QtSql
    - -isystem
    - /usr/lib64/qt6/include/QtCharts
    - -isystem
    - /usr/lib64/qt6/include/QtPrintSupport
    - -isystem
    - /usr/lib64/qt6/mkspecs/linux-clang
  Compiler: g++

Diagnostics:
  Suppress:
    - "type_traits"
    - "operator|"
    - "unused-includes"
