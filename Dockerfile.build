# OpenEkklesia Linux build container.
# Purpose: produce an AppImage whose bundled libraries require only Ubuntu
# 22.04's glibc 2.35 baseline, so the artifact runs on stable distributions
# (Linux Mint 21+, Ubuntu 22.04+, Debian 12+) instead of only on the
# rolling host used for day-to-day development (glibc 2.44).
#
# Build:  podman build -f Dockerfile.build -t openekklesia-build .
# Run:    ./build-linux-appimage-container.sh
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        ninja-build \
        qt6-base-dev \
        libqt6charts6-dev \
        libqt6printsupport6 \
        libgl1-mesa-dev \
        libvulkan-dev \
        file \
        curl \
        ca-certificates \
        zsync \
        desktop-file-utils \
    && rm -rf /var/lib/apt/lists/*

# AppImage tooling runs its own runtime; allow extract-and-run inside the
# container (no FUSE there) via the env var already honored by our script.
ENV APPIMAGE_EXTRACT_AND_RUN=1

WORKDIR /src
CMD ["./build-linux-appimage.sh"]
